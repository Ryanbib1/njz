'use client'

import React from 'react';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import type { FoodOrderState, FoodOrderHandlers } from '@/frontend/hooks/useFoodOrder';

interface Props {
  state: FoodOrderState;
  handlers: FoodOrderHandlers;
}

export const FoodOrderView = ({ state, handlers }: Props) => {
  const {
    isLoading,
    categories,
    activeCategory,
    filteredDishes,
    cart,
    form,
    isSubmitting,
    cartSummary,
    checkoutError
  } = state;

  const {
    setActiveCategory,
    handleUpdateQuantity,
    handleFormChange,
    handleCheckout
  } = handlers;

  if (isLoading) {
    return (
      <section>
        <p>Loading menu...</p>
      </section>
    );
  }

  return (
    <article>
      {/* Hero Section */}
      <header>
        <img 
          src="/images/hero-kitchen.jpg" 
          alt="Kitchen or dining table" 
        />
        <h1>Il Menu d'Asporto</h1>
        <p>Bring the authentic wood-fired Tavola experience to your dining room. Crafted with uncompromising quality.</p>
      </header>

      {/* Main Content Split */}
      <div>
        {/* Left Column: Menu Browsing */}
        <main>
          {/* Category Filters */}
          <nav>
            {categories.map(category => (
              <button 
                key={category} 
                onClick={() => setActiveCategory(category)}
                disabled={category === activeCategory}
              >
                {category}
              </button>
            ))}
          </nav>

          <hr />

          {/* Dish List */}
          <section>
            {filteredDishes.length === 0 ? (
              <p>No dishes available in this category.</p>
            ) : (
              <div>
                {filteredDishes.map(dish => (
                  <article key={dish.dish_id}>
                    <img 
                      src={dish.image_url} 
                      alt={dish.name} 
                    />
                    <div>
                      <h2>{dish.name}</h2>
                      <p>{dish.description}</p>
                      <p>${dish.price.toFixed(2)}</p>
                    </div>
                    <div>
                      <button 
                        onClick={() => handleUpdateQuantity(dish.dish_id, -1)}
                        disabled={!cart[dish.dish_id]}
                      >
                        -
                      </button>
                      <span>{cart[dish.dish_id] || 0}</span>
                      <button 
                        onClick={() => handleUpdateQuantity(dish.dish_id, 1)}
                      >
                        +
                      </button>
                    </div>
                  </article>
                ))}
              </div>
            )}
          </section>
        </main>

        <hr />

        {/* Right Column: Checkout Panel */}
        <aside>
          {/* Pickup Details Form */}
          <section>
            <h2>Pickup Details</h2>
            <form onSubmit={e => e.preventDefault()}>
              <div>
                <label htmlFor="pickup_name">Name</label>
                <Input 
                  id="pickup_name"
                  type="text" 
                  value={form.pickup_name}
                  onChange={(e) => handleFormChange('pickup_name', e.target.value)}
                  disabled={isSubmitting}
                />
              </div>
              <div>
                <label htmlFor="pickup_phone">Phone Number</label>
                <Input 
                  id="pickup_phone"
                  type="tel" 
                  value={form.pickup_phone}
                  onChange={(e) => handleFormChange('pickup_phone', e.target.value)}
                  disabled={isSubmitting}
                />
              </div>
              <div>
                <label htmlFor="customer_email">Customer Email</label>
                <Input 
                  id="customer_email"
                  type="email" 
                  value={form.customer_email}
                  onChange={(e) => handleFormChange('customer_email', e.target.value)}
                  disabled={isSubmitting}
                />
              </div>
            </form>
          </section>

          <hr />

          {/* Order Summary */}
          <section>
            <h2>Your Order</h2>
            {cartSummary.items.length === 0 ? (
              <p>Your cart is empty.</p>
            ) : (
              <ul>
                {cartSummary.items.map(item => (
                  <li key={item.dish_id}>
                    <span>{item.name}</span>
                    <span>x{item.quantity}</span>
                    <span>${item.itemTotal.toFixed(2)}</span>
                  </li>
                ))}
              </ul>
            )}

            <hr />
            
            <div>
              <p>
                <span>Subtotal</span>
                <span>${cartSummary.subtotal.toFixed(2)}</span>
              </p>
              <p>
                <span>Tax</span>
                <span>${cartSummary.tax.toFixed(2)}</span>
              </p>
              <p>
                <strong>Grand Total</strong>
                <strong>${cartSummary.grandTotal.toFixed(2)}</strong>
              </p>
            </div>
          </section>

          {/* Action & Feedback */}
          <section>
            {checkoutError && (
              <div>
                <p>{checkoutError}</p>
              </div>
            )}
            <Button 
              onClick={handleCheckout} 
              disabled={isSubmitting || cartSummary.items.length === 0}
            >
              {isSubmitting ? 'Processing...' : 'Proceed to Payment'}
            </Button>
          </section>
        </aside>
      </div>
    </article>
  );
};